# Local working notes (planning docs, drafts, scratch)
notes/
openspec/
*.local.*
!docker-compose.local.yml
!docker-compose.memx.local.yml
.tmp-*
_tmp_*
audit_*.txt
audit_*.jsonl

# Personal-data blocklist for pre-commit hook (per-dev, never tracked).
.githooks/blocklist

# Admin desktop app sources are kept in a separate local repository.
admin/

# Build and release artefacts stay local. Keep only the directory placeholder.
dist/*
!dist/admin/
dist/admin/*
!dist/admin/.gitkeep

# Nanobot runtime workspace inside the familia source tree (test-run
# artifact: HEARTBEAT/AGENTS/USER/SOUL/TOOLS, cron jobs, history,
# .git store). Re-created on every gateway boot.
familia/workspace/

# Secrets & runtime state
.env
.env.*
!.env.example
audit.jsonl

# User-specific runtime config (only the example is tracked)
principals.json
!principals.example.json
memx-config/acl.json
!memx-config/acl.example.json

# Upstream source snapshots (not part of this repo)
vendor/

# Python build artifacts
*.egg-info/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc

# Editor / IDE
.idea/
.vscode/

# MCP code-index
.code-index/
.mcp.json
AGENTS.md
