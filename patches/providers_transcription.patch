+            url,
+            provider_label="Yandex",
+            headers=headers,
+            params=params,
+            content=data,
+            timeout=30.0,
+        )
+    if not payload:
+        return ""
+    if payload.get("error_code") or payload.get("error_message"):
+        logger.warning("Yandex STT error: {}", payload)
+        return ""
+    text = payload.get("result")
+    return text.strip() if isinstance(text, str) else ""
