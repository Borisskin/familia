+"""Neutral callback dispatching extension point."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Awaitable, Callable
+from typing import Protocol
+
+from loguru import logger
+
+from nanobot.bus.events import CallbackEvent
+from nanobot.bus.queue import MessageBus
+
+
+class CallbackHandler(Protocol):
+    """Handle one callback press and report whether it was consumed."""
+
+    async def handle_callback(self, event: CallbackEvent) -> bool:
+        ...
+
+
+CallbackHandlerFunc = Callable[[CallbackEvent], Awaitable[bool]]
+
+
+class CallbackDispatcher:
+    """Drain bus callbacks through registered neutral handlers."""
+
+    def __init__(
+        self,
+        bus: MessageBus,
+        handlers: list[CallbackHandler | CallbackHandlerFunc] | None = None,
+    ) -> None:
+        self.bus = bus
+        self.handlers = handlers or []
+        self._task: asyncio.Task[None] | None = None
+        self._running = False
+
+    async def start(self) -> None:
+        if self._task is not None:
+            return
+        self._running = True
+        self._task = asyncio.create_task(self._run(), name="callback-dispatcher")
+
+    async def stop(self) -> None:
+        self._running = False
+        if self._task is None:
+            return
+        self._task.cancel()
+        try:
+            await self._task
+        except asyncio.CancelledError:
+            pass
+        except Exception as exc:
+            logger.warning("Callback dispatcher task raised on shutdown: {}", exc)
+        self._task = None
+
+    async def _run(self) -> None:
+        while self._running:
+            try:
+                event = await self.bus.consume_callback()
+            except asyncio.CancelledError:
+                break
+            await self._dispatch(event)
+
+    async def _dispatch(self, event: CallbackEvent) -> None:
+        for handler in self.handlers:
+            try:
+                if hasattr(handler, "handle_callback"):
+                    handled = await handler.handle_callback(event)
+                else:
+                    handled = await handler(event)
+            except Exception:
+                logger.exception("Callback handler failed for event={!r}", event)
+                continue
+            if handled:
+                return
+        logger.warning(
+            "Unhandled callback event: channel={} chat={} actor={}",
+            event.channel,
+            event.chat_id,
+            event.actor,
+        )
