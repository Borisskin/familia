+@pytest.mark.asyncio
+async def test_structured_callback_publishes_typed_event() -> None:
+    bus = MessageBus()
+    channel = TelegramChannel(
+        TelegramConfig(enabled=True, token="123:abc", allow_from=["*"], inline_keyboards=True),
+        bus,
+    )
+    markup = channel._build_keyboard({
+        "inline": True,
+        "correlation_id": "cid-2",
+        "rows": [[{"label": "✅ Да", "payload": "opaque"}]],
+    })
+    query = SimpleNamespace(
+        id="cb-2",
+        data="f1:cid-2|opaque",
+        answer=AsyncMock(),
+        message=SimpleNamespace(
+            chat_id=123,
+            reply_markup=markup,
+            edit_reply_markup=AsyncMock(),
+        ),
+    )
+    update = SimpleNamespace(
+        callback_query=query,
+        effective_user=SimpleNamespace(id=12345, username="alice", first_name="Alice"),
+    )
+    channel._handle_message = AsyncMock()
+
+    await channel._on_callback_query(update, None)
+
+    event = await bus.consume_callback()
+    assert event.channel == "telegram"
+    assert event.sender_id == "12345|alice"
+    assert event.chat_id == "123"
+    assert event.payload == "opaque"
+    assert event.actor is None
+    assert event.metadata["correlation_id"] == "cid-2"
+    assert event.metadata["pressed_label"] == "✅ Да"
+    channel._handle_message.assert_not_awaited()

