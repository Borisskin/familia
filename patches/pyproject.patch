# nanobot baseline: 0.1.5.post2
# upstream commit: 950dddec499fbbe0353e997158c99808f0bb41e1

diff --git a/nanobot/pyproject.toml b/nanobot/pyproject.toml
index 1e4ca97..bc7c847 100644
--- a/nanobot/pyproject.toml
+++ b/nanobot/pyproject.toml
@@ -118,6 +118,13 @@ include = [
     "nanobot/skills/**/*.md",
     "nanobot/skills/**/*.sh",
 ]
+# Build-time generated assets that live under .gitignore'd paths but must ship
+# in the wheel/sdist. `artifacts` bypasses the VCS filter (unlike `include`).
+# The webui is compiled via `bun run build` into nanobot/web/dist/ right before
+# `python -m build` runs.
+artifacts = [
+    "nanobot/web/dist/**/*",
+]
 
 [tool.hatch.build.targets.wheel]
 packages = ["nanobot"]
