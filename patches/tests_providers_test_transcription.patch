+@pytest.mark.asyncio
+async def test_yandex_long_audio_splits_and_cleans_chunks(tmp_path: Path) -> None:
+    source = tmp_path / "voice.ogg"
+    source.write_bytes(b"source-too-large")
+    chunks = [tmp_path / "segment-1.ogg", tmp_path / "segment-2.ogg"]
+    for chunk in chunks:
+        chunk.write_bytes(b"x")
+    provider = YandexTranscriptionProvider(api_key="k", folder_id="f")
+    provider.MAX_PAYLOAD_BYTES = 1
+    split = AsyncMock(return_value=chunks)
+    post = AsyncMock(side_effect=["first", "second"])
+    cleanup = patch("nanobot.providers.transcription._cleanup_chunks")
+
+    with (
+        patch("nanobot.providers.transcription.probe_audio_duration_s", AsyncMock(return_value=31)),
+        patch("nanobot.providers.transcription.split_audio_with_ffmpeg", split),
+        patch("nanobot.providers.transcription._post_yandex_transcription_with_retry", post),
+        cleanup as cleanup_mock,
+    ):
+        result = await provider.transcribe(source)
+
+    assert result == "first second"
+    split.assert_awaited_once_with(
+        source,
+        target_bytes=1,
+        duration_s=provider.CHUNK_DURATION_S,
+        log_prefix="Yandex STT",
+    )
+    assert post.await_count == 2
+    assert cleanup_mock.call_args.args == (chunks,)
+
+
