+@pytest.mark.asyncio
+async def test_yandex_sends_raw_audio_with_api_key_and_folder_id(audio_file: Path) -> None:
+    provider = YandexTranscriptionProvider(
+        api_key="yc-api-key",
+        folder_id="b1-folder",
+        api_base="https://speech.example/stt:recognize",
+        language="ru-RU",
+    )
+    post = AsyncMock(return_value=_response(200, {"result": "привет"}))
+
+    with (
+        patch("nanobot.providers.transcription.probe_audio_duration_s", AsyncMock(return_value=1)),
+        patch("httpx.AsyncClient.post", post),
+        patch("asyncio.sleep", AsyncMock()),
+    ):
+        result = await provider.transcribe(audio_file)
+
+    assert result == "привет"
+    assert post.await_count == 1
+    call = post.await_args
+    assert call.args == (provider.api_url,)
+    assert call.kwargs["headers"] == {"Authorization": "Api-Key yc-api-key"}
+    assert call.kwargs["params"] == {
+        "folderId": "b1-folder",
+        "lang": "ru-RU",
+        "format": "oggopus",
+    }
+    assert call.kwargs["content"] == audio_file.read_bytes()
+
