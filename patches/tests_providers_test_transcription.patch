+@pytest.mark.parametrize(
+    "provider_name,provider_class_name",
+    [
+        ("openai", "OpenAITranscriptionProvider"),
+        ("groq", "GroqTranscriptionProvider"),
+    ],
+)
+@pytest.mark.asyncio
+async def test_existing_provider_routes_keep_common_kwargs(
+    audio_file: Path, provider_name: str, provider_class_name: str
+) -> None:
+    captured: dict[str, object] = {}
+
+    class StubProvider:
+        def __init__(self, **kwargs: object) -> None:
+            captured.update(kwargs)
+
+        async def transcribe(self, file_path: str | Path) -> str:
+            captured["file_path"] = Path(file_path)
+            return "ok"
+
+    config = EffectiveTranscriptionConfig(
+        enabled=True,
+        provider=provider_name,
+        model="custom-model",
+        language="en",
+        api_key="provider-key",
+        api_base="https://speech.example/v1",
+        max_duration_sec=120,
+        max_upload_mb=25,
+    )
+
+    with patch(f"nanobot.providers.transcription.{provider_class_name}", StubProvider):
+        assert await transcribe_audio_file(audio_file, config) == "ok"
+
+    assert captured == {
+        "api_key": "provider-key",
+        "api_base": "https://speech.example/v1",
+        "language": "en",
+        "model": "custom-model",
+        "file_path": audio_file,
+    }
+
