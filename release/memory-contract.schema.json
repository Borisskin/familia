{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familia.local/schemas/memory-contract-1.0.0.json",
  "title": "Familia authoritative memory contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authority",
    "identity",
    "routes",
    "access_matrix",
    "destination_registry",
    "pair_codec",
    "semantic_results",
    "migration",
    "legacy_compatibility",
    "failure_rules",
    "release_compatibility"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_export", "ontology", "consumer_rule"],
      "properties": {
        "canonical_export": {
          "const": "familia.memory_contract.MEMORY_CONTRACT"
        },
        "ontology": {
          "const": "single"
        },
        "consumer_rule": {
          "const": "derive_from_this_contract"
        }
      }
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "routes": {
      "$ref": "#/$defs/routes"
    },
    "access_matrix": {
      "$ref": "#/$defs/accessMatrix"
    },
    "destination_registry": {
      "$ref": "#/$defs/destinationRegistry"
    },
    "pair_codec": {
      "$ref": "#/$defs/pairCodec"
    },
    "semantic_results": {
      "$ref": "#/$defs/semanticResults"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "legacy_compatibility": {
      "$ref": "#/$defs/legacyCompatibility"
    },
    "failure_rules": {
      "$ref": "#/$defs/failureRules"
    },
    "release_compatibility": {
      "$ref": "#/$defs/releaseCompatibility"
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal_id",
        "multi_principal",
        "executor_destination_owner_distinct"
      ],
      "properties": {
        "principal_id": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_regex",
            "encoding",
            "normalization",
            "registered_required"
          ],
          "properties": {
            "canonical_regex": {
              "const": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "encoding": {
              "const": "UTF-8"
            },
            "normalization": {
              "const": "none"
            },
            "registered_required": {
              "const": true
            }
          }
        },
        "multi_principal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "explicit_actor_required",
            "actor_must_be_canonical",
            "actor_must_be_registered",
            "missing_or_invalid_outcome"
          ],
          "properties": {
            "explicit_actor_required": {
              "const": true
            },
            "actor_must_be_canonical": {
              "const": true
            },
            "actor_must_be_registered": {
              "const": true
            },
            "missing_or_invalid_outcome": {
              "const": "denied_invalid"
            }
          }
        },
        "executor_destination_owner_distinct": {
          "const": true
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PRIVATE", "SHARED", "PAIR"],
      "properties": {
        "PRIVATE": {
          "$ref": "#/$defs/privateRoute"
        },
        "SHARED": {
          "$ref": "#/$defs/sharedRoute"
        },
        "PAIR": {
          "$ref": "#/$defs/pairRoute"
        }
      }
    },
    "privateRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "visibility", "destination"],
      "properties": {
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "cardinality"],
          "properties": {
            "rule": {
              "const": "explicit_principal"
            },
            "cardinality": {
              "const": 1
            }
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "sensitivity_can_widen_access"],
          "properties": {
            "rule": {
              "const": "owner_only"
            },
            "sensitivity_can_widen_access": {
              "const": false
            }
          }
        },
        "destination": {
          "$ref": "#/$defs/privateDestination"
        }
      }
    },
    "sharedRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "visibility", "destination"],
      "properties": {
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "cardinality", "writer_is_default"],
          "properties": {
            "rule": {
              "const": "explicit_family_shared_namespace"
            },
            "cardinality": {
              "const": 1
            },
            "writer_is_default": {
              "const": false
            }
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "policy"],
          "properties": {
            "rule": {
              "const": "relationship_policy"
            },
            "policy": {
              "const": "familia_graph_v1"
            }
          }
        },
        "destination": {
          "$ref": "#/$defs/sharedDestination"
        }
      }
    },
    "pairRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "visibility", "destination"],
      "properties": {
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "cardinality",
            "member_cardinality",
            "members_distinct"
          ],
          "properties": {
            "rule": {
              "const": "canonical_unordered_pair"
            },
            "cardinality": {
              "const": 1
            },
            "member_cardinality": {
              "const": 2
            },
            "members_distinct": {
              "const": true
            }
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "member_cardinality",
            "relationship_can_add_members"
          ],
          "properties": {
            "rule": {
              "const": "exact_members_only"
            },
            "member_cardinality": {
              "const": 2
            },
            "relationship_can_add_members": {
              "const": false
            }
          }
        },
        "destination": {
          "$ref": "#/$defs/pairDestination"
        }
      }
    },
    "privateDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "cardinality"],
      "properties": {
        "registry_id": {
          "const": "private_principal_memory"
        },
        "cardinality": {
          "const": 1
        }
      }
    },
    "sharedDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "cardinality"],
      "properties": {
        "registry_id": {
          "const": "shared_family_memory"
        },
        "cardinality": {
          "const": 1
        }
      }
    },
    "pairDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "cardinality"],
      "properties": {
        "registry_id": {
          "const": "canonical_pair_memory"
        },
        "cardinality": {
          "const": 1
        }
      }
    },
    "accessMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_policy", "PRIVATE", "SHARED", "PAIR"],
      "properties": {
        "relationship_policy": {
          "const": "familia_graph_v1"
        },
        "PRIVATE": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "non_owner",
            "secret_or_other_tags_change_access"
          ],
          "properties": {
            "owner": {
              "const": "allow"
            },
            "non_owner": {
              "const": "deny"
            },
            "secret_or_other_tags_change_access": {
              "const": false
            }
          }
        },
        "SHARED": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "related", "unrelated", "unknown_relationship"],
          "properties": {
            "owner": {
              "const": "allow"
            },
            "related": {
              "const": "familia_graph_v1"
            },
            "unrelated": {
              "const": "deny"
            },
            "unknown_relationship": {
              "const": "deny"
            }
          }
        },
        "PAIR": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "member",
            "outsider",
            "relationship_to_member_changes_access"
          ],
          "properties": {
            "member": {
              "const": "allow"
            },
            "outsider": {
              "const": "deny"
            },
            "relationship_to_member_changes_access": {
              "const": false
            }
          }
        }
      }
    },
    "destinationRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "arbitrary_destinations_allowed",
        "generic_file_fallback_allowed",
        "entries"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "arbitrary_destinations_allowed": {
          "const": false
        },
        "generic_file_fallback_allowed": {
          "const": false
        },
        "entries": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "private_principal_memory",
            "shared_family_memory",
            "canonical_pair_memory"
          ],
          "properties": {
            "private_principal_memory": {
              "$ref": "#/$defs/privateRegistryEntry"
            },
            "shared_family_memory": {
              "$ref": "#/$defs/sharedRegistryEntry"
            },
            "canonical_pair_memory": {
              "$ref": "#/$defs/pairRegistryEntry"
            }
          }
        }
      }
    },
    "privateRegistryEntry": {
      "$ref": "#/$defs/registryEntry",
      "properties": {
        "scope": {
          "const": "PRIVATE"
        },
        "owner_binding": {
          "const": "explicit_principal"
        }
      }
    },
    "sharedRegistryEntry": {
      "$ref": "#/$defs/registryEntry",
      "properties": {
        "scope": {
          "const": "SHARED"
        },
        "owner_binding": {
          "const": "explicit_family_shared_namespace"
        }
      }
    },
    "pairRegistryEntry": {
      "$ref": "#/$defs/registryEntry",
      "properties": {
        "scope": {
          "const": "PAIR"
        },
        "owner_binding": {
          "const": "canonical_unordered_pair"
        }
      }
    },
    "registryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "owner_binding", "retrieval", "write_only_archive"],
      "properties": {
        "scope": {
          "enum": ["PRIVATE", "SHARED", "PAIR"]
        },
        "owner_binding": {
          "enum": [
            "explicit_principal",
            "explicit_family_shared_namespace",
            "canonical_unordered_pair"
          ]
        },
        "retrieval": {
          "const": "intended_principal_next_turn"
        },
        "write_only_archive": {
          "const": false
        }
      }
    },
    "pairCodec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "implementation_status",
        "principal_id_domain",
        "member_cardinality",
        "members_distinct",
        "ordering",
        "physical_grammar",
        "length_grammar",
        "decode_rejection_rules",
        "injective_over_full_id_domain",
        "shared_by",
        "collision_vector",
        "legacy"
      ],
      "properties": {
        "version": {
          "const": "pair-key-v1"
        },
        "implementation_status": {
          "const": "implemented_RP-040"
        },
        "principal_id_domain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_regex", "encoding", "normalization"],
          "properties": {
            "canonical_regex": {
              "const": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "encoding": {
              "const": "UTF-8"
            },
            "normalization": {
              "const": "none"
            }
          }
        },
        "member_cardinality": {
          "const": 2
        },
        "members_distinct": {
          "const": true
        },
        "ordering": {
          "const": "ascending_utf8_bytes"
        },
        "physical_grammar": {
          "const": "pair-v1/<decimal-utf8-byte-length>:<id>/<decimal-utf8-byte-length>:<id>"
        },
        "length_grammar": {
          "const": "base10_no_leading_zero_positive_integer"
        },
        "decode_rejection_rules": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "invalid_prefix",
              "invalid_or_noncanonical_length",
              "invalid_utf8_or_principal_id",
              "truncated_or_surplus_member_bytes",
              "noncanonical_member_order",
              "duplicate_members",
              "trailing_bytes"
            ]
          }
        },
        "injective_over_full_id_domain": {
          "const": true
        },
        "shared_by": {
          "const": ["value_keys", "acl_generation"]
        },
        "collision_vector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left_members",
            "right_members",
            "left_encoding",
            "right_encoding",
            "must_differ"
          ],
          "properties": {
            "left_members": {
              "const": ["a_b", "c"]
            },
            "right_members": {
              "const": ["a", "b_c"]
            },
            "left_encoding": {
              "const": "pair-v1/3:a_b/1:c"
            },
            "right_encoding": {
              "const": "pair-v1/1:a/3:b_c"
            },
            "must_differ": {
              "const": true
            }
          }
        },
        "legacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delimiter_keys_are_current",
            "translation",
            "ambiguous_outcome",
            "ambiguous_writes"
          ],
          "properties": {
            "delimiter_keys_are_current": {
              "const": false
            },
            "translation": {
              "const": "manifest_required"
            },
            "ambiguous_outcome": {
              "const": "quarantine_needs_review"
            },
            "ambiguous_writes": {
              "const": 0
            }
          }
        }
      }
    },
    "semanticResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed",
        "retryable_failure",
        "denied_invalid",
        "quarantine_needs_review",
        "not_updated"
      ],
      "properties": {
        "committed": {
          "$ref": "#/$defs/committedResult"
        },
        "retryable_failure": {
          "$ref": "#/$defs/retryableResult"
        },
        "denied_invalid": {
          "$ref": "#/$defs/deniedResult"
        },
        "quarantine_needs_review": {
          "$ref": "#/$defs/quarantineResult"
        },
        "not_updated": {
          "$ref": "#/$defs/notUpdatedResult"
        }
      }
    },
    "resultShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durably_committed",
        "retryable",
        "requires_review",
        "transport_updated",
        "cursor_may_advance"
      ],
      "properties": {
        "durably_committed": {
          "type": "boolean"
        },
        "retryable": {
          "type": "boolean"
        },
        "requires_review": {
          "type": "boolean"
        },
        "transport_updated": {
          "type": ["boolean", "null"]
        },
        "cursor_may_advance": {
          "type": "boolean"
        }
      }
    },
    "committedResult": {
      "$ref": "#/$defs/resultShape",
      "properties": {
        "durably_committed": {"const": true},
        "retryable": {"const": false},
        "requires_review": {"const": false},
        "transport_updated": {"const": true},
        "cursor_may_advance": {"const": true}
      }
    },
    "retryableResult": {
      "$ref": "#/$defs/resultShape",
      "properties": {
        "durably_committed": {"const": false},
        "retryable": {"const": true},
        "requires_review": {"const": false},
        "transport_updated": {"const": null},
        "cursor_may_advance": {"const": false}
      }
    },
    "deniedResult": {
      "$ref": "#/$defs/resultShape",
      "properties": {
        "durably_committed": {"const": false},
        "retryable": {"const": false},
        "requires_review": {"const": false},
        "transport_updated": {"const": null},
        "cursor_may_advance": {"const": false}
      }
    },
    "quarantineResult": {
      "$ref": "#/$defs/resultShape",
      "properties": {
        "durably_committed": {"const": false},
        "retryable": {"const": false},
        "requires_review": {"const": true},
        "transport_updated": {"const": null},
        "cursor_may_advance": {"const": false}
      }
    },
    "notUpdatedResult": {
      "$ref": "#/$defs/resultShape",
      "properties": {
        "durably_committed": {"const": false},
        "retryable": {"const": true},
        "requires_review": {"const": false},
        "transport_updated": {"const": false},
        "cursor_may_advance": {"const": false}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispositions",
        "ambiguous_provenance",
        "legacy_input",
        "delete"
      ],
      "properties": {
        "dispositions": {
          "const": [
            "retain",
            "rekey",
            "deduplicate",
            "quarantine",
            "delete"
          ]
        },
        "ambiguous_provenance": {
          "$ref": "#/$defs/quarantineZeroWrites"
        },
        "legacy_input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification_required",
            "accepted_as_current_semantics"
          ],
          "properties": {
            "classification_required": {
              "const": true
            },
            "accepted_as_current_semantics": {
              "const": false
            }
          }
        },
        "delete": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "performed_by_RP-000",
            "record_level_approval_required"
          ],
          "properties": {
            "performed_by_RP-000": {
              "const": false
            },
            "record_level_approval_required": {
              "const": true
            }
          }
        }
      }
    },
    "quarantineZeroWrites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "writes"],
      "properties": {
        "outcome": {
          "const": "quarantine_needs_review"
        },
        "writes": {
          "const": 0
        }
      }
    },
    "historyQuarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_included", "outcome", "principal_graph_writes"],
      "properties": {
        "prompt_included": {
          "const": false
        },
        "outcome": {
          "const": "quarantine_needs_review"
        },
        "principal_graph_writes": {
          "const": 0
        }
      }
    },
    "legacyCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history", "global_files", "pair_keys", "private_peer_read"],
      "properties": {
        "history": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actorless_multi_principal",
            "unknown_actor_multi_principal",
            "actorless_explicit_standalone"
          ],
          "properties": {
            "actorless_multi_principal": {
              "$ref": "#/$defs/historyQuarantine"
            },
            "unknown_actor_multi_principal": {
              "$ref": "#/$defs/historyQuarantine"
            },
            "actorless_explicit_standalone": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "local_read_allowed",
                "auto_promote_to_principal_graph",
                "principal_graph_writes"
              ],
              "properties": {
                "local_read_allowed": {
                  "const": true
                },
                "auto_promote_to_principal_graph": {
                  "const": false
                },
                "principal_graph_writes": {
                  "const": 0
                }
              }
            }
          }
        },
        "global_files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["names", "fan_out_allowed", "classification_required"],
          "properties": {
            "names": {
              "const": ["USER.md", "MEMORY.md", "HEARTBEAT.md"]
            },
            "fan_out_allowed": {
              "const": false
            },
            "classification_required": {
              "const": true
            }
          }
        },
        "pair_keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["governed_by"],
          "properties": {
            "governed_by": {
              "const": "pair_codec.legacy"
            }
          }
        },
        "private_peer_read": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled_automatically",
            "shared_reclassification_requires_manifest_and_approval"
          ],
          "properties": {
            "enabled_automatically": {
              "const": false
            },
            "shared_reclassification_requires_manifest_and_approval": {
              "const": true
            }
          }
        }
      }
    },
    "failureRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_scope",
        "invalid_actor_multi_principal",
        "malformed_pair",
        "unregistered_destination"
      ],
      "properties": {
        "unknown_scope": {
          "$ref": "#/$defs/deniedZeroWrites"
        },
        "invalid_actor_multi_principal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "outcome",
            "destination_selected",
            "writes",
            "prompt_assembly_allowed"
          ],
          "properties": {
            "cases": {
              "const": [
                "missing",
                "blank",
                "malformed",
                "non_canonical",
                "unknown_to_registry"
              ]
            },
            "outcome": {
              "const": "denied_invalid"
            },
            "destination_selected": {
              "const": false
            },
            "writes": {
              "const": 0
            },
            "prompt_assembly_allowed": {
              "const": false
            }
          }
        },
        "malformed_pair": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cases", "outcome", "destination_selected", "writes"],
          "properties": {
            "cases": {
              "const": [
                "missing_member",
                "one_member",
                "three_or_more_members",
                "duplicate_members",
                "invalid_member",
                "noncanonical_order"
              ]
            },
            "outcome": {
              "const": "denied_invalid"
            },
            "destination_selected": {
              "const": false
            },
            "writes": {
              "const": 0
            }
          }
        },
        "unregistered_destination": {
          "type": "object",
          "additionalProperties": false,
