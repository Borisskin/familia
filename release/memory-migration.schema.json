{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familia.invalid/schemas/memory-migration-2.0.0.json",
  "title": "Familia memory migration report 2.0.0",
  "oneOf": [
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/apply" }
  ],
  "$defs": {
    "rowId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "planRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "outcome"],
      "properties": {
        "row_id": { "$ref": "#/$defs/rowId" },
        "outcome": { "enum": ["planned", "blocked_needs_review"] }
      }
    },
    "plannedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "outcome"],
      "properties": {
        "row_id": { "$ref": "#/$defs/rowId" },
        "outcome": { "const": "planned" }
      }
    },
    "applyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "outcome"],
      "properties": {
        "row_id": { "$ref": "#/$defs/rowId" },
        "outcome": {
          "enum": [
            "imported",
            "duplicate",
            "awaiting_owner",
            "discarded_unknown",
            "retryable_failure"
          ]
        }
      }
    },
    "terminalApplyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "outcome"],
      "properties": {
        "row_id": { "$ref": "#/$defs/rowId" },
        "outcome": {
          "enum": [
            "imported",
            "duplicate",
            "awaiting_owner",
            "discarded_unknown"
          ]
        }
      }
    },
    "retryableApplyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "outcome"],
      "properties": {
        "row_id": { "$ref": "#/$defs/rowId" },
        "outcome": { "const": "retryable_failure" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flat_files_empty",
        "soul_verified",
        "registry_verified",
        "memx_verified",
        "receipts_verified",
        "target_invariants_verified",
        "no_unfinished_rows",
        "unknown_content_discarded"
      ],
      "properties": {
        "flat_files_empty": { "type": "boolean" },
        "soul_verified": { "type": "boolean" },
        "registry_verified": { "type": "boolean" },
        "memx_verified": { "type": "boolean" },
        "receipts_verified": { "type": "boolean" },
        "target_invariants_verified": { "type": "boolean" },
        "no_unfinished_rows": { "type": "boolean" },
        "unknown_content_discarded": { "type": "boolean" }
      }
    },
    "completeChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flat_files_empty",
        "soul_verified",
        "registry_verified",
        "memx_verified",
        "receipts_verified",
        "target_invariants_verified",
        "no_unfinished_rows",
        "unknown_content_discarded"
      ],
      "properties": {
        "flat_files_empty": { "const": true },
        "soul_verified": { "const": true },
        "registry_verified": { "const": true },
        "memx_verified": { "const": true },
        "receipts_verified": { "const": true },
        "target_invariants_verified": { "const": true },
        "no_unfinished_rows": { "const": true },
        "unknown_content_discarded": { "const": true }
      }
    },
    "partialChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flat_files_empty",
        "soul_verified",
        "registry_verified",
        "memx_verified",
        "receipts_verified",
        "target_invariants_verified",
        "no_unfinished_rows",
        "unknown_content_discarded"
      ],
      "properties": {
        "flat_files_empty": { "const": true },
        "soul_verified": { "const": true },
        "registry_verified": { "const": true },
        "memx_verified": { "const": true },
        "receipts_verified": { "const": true },
        "target_invariants_verified": { "const": true },
        "no_unfinished_rows": { "const": false },
        "unknown_content_discarded": { "const": true }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "phase",
        "dry_run",
        "migration_kind",
        "source_contract_version",
        "target_contract_version",
        "status",
        "rows",
        "exit_code"
      ],
      "properties": {
        "schema_version": { "const": "2.0.0" },
        "phase": { "const": "plan" },
        "dry_run": { "const": true },
        "migration_kind": { "enum": ["legacy_upgrade", "current_verify"] },
        "source_contract_version": {
          "enum": ["legacy-unversioned", "1.0.0", "2.0.0"]
        },
        "target_contract_version": { "const": "2.0.0" },
        "status": { "enum": ["planned", "blocked_needs_review"] },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/planRow" }
        },
        "exit_code": { "const": 2 }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "migration_kind": { "const": "legacy_upgrade" },
                "source_contract_version": {
                  "enum": ["legacy-unversioned", "1.0.0"]
                }
              }
            },
            {
              "properties": {
                "migration_kind": { "const": "current_verify" },
                "source_contract_version": { "const": "2.0.0" }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "status": { "const": "planned" },
                "rows": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/plannedRow" }
                }
              }
            },
            {
              "properties": {
                "status": { "const": "blocked_needs_review" },
                "rows": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "required": ["outcome"],
                    "properties": {
                      "outcome": { "const": "blocked_needs_review" }
                    }
                  },
                  "minContains": 1
                }
              }
            }
          ]
        }
      ]
    },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "phase",
        "dry_run",
        "migration_kind",
        "source_contract_version",
        "target_contract_version",
        "status",
        "rows",
        "checks",
        "exit_code"
      ],
      "properties": {
        "schema_version": { "const": "2.0.0" },
        "phase": { "const": "apply" },
        "dry_run": { "const": false },
        "migration_kind": { "enum": ["legacy_upgrade", "current_verify"] },
        "source_contract_version": {
          "enum": ["legacy-unversioned", "1.0.0", "2.0.0"]
        },
        "target_contract_version": { "const": "2.0.0" },
        "status": { "enum": ["complete", "partial", "failed"] },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/applyRow" }
        },
        "checks": { "$ref": "#/$defs/checks" },
        "exit_code": { "enum": [0, 1, 2] }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "migration_kind": { "const": "legacy_upgrade" },
                "source_contract_version": {
                  "enum": ["legacy-unversioned", "1.0.0"]
                }
              }
            },
            {
              "properties": {
                "migration_kind": { "const": "current_verify" },
                "source_contract_version": { "const": "2.0.0" },
                "rows": { "maxItems": 0 }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "rows": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/terminalApplyRow" }
                },
                "checks": {
                  "type": "object",
                  "required": ["no_unfinished_rows"],
                  "properties": {
                    "no_unfinished_rows": { "const": true }
                  }
                }
              }
            },
            {
              "properties": {
                "rows": {
                  "type": "array",
                  "contains": { "$ref": "#/$defs/retryableApplyRow" },
                  "minContains": 1
                },
                "checks": {
                  "type": "object",
                  "required": ["no_unfinished_rows"],
                  "properties": {
                    "no_unfinished_rows": { "const": false }
                  }
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "status": { "const": "complete" },
                "rows": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/terminalApplyRow" }
                },
                "checks": { "$ref": "#/$defs/completeChecks" },
                "exit_code": { "const": 0 }
              }
            },
            {
              "properties": {
                "status": { "const": "partial" },
                "rows": {
                  "type": "array",
                  "contains": { "$ref": "#/$defs/retryableApplyRow" },
                  "minContains": 1
                },
                "checks": { "$ref": "#/$defs/partialChecks" },
                "exit_code": { "const": 2 }
              }
            },
            {
              "properties": {
                "status": { "const": "failed" },
                "checks": {
                  "anyOf": [
                    {
                      "properties": {
                        "flat_files_empty": { "const": false }
                      }
                    },
                    {
                      "properties": {
                        "soul_verified": { "const": false }
                      }
                    },
                    {
                      "properties": {
                        "registry_verified": { "const": false }
                      }
                    },
                    {
                      "properties": {
                        "memx_verified": { "const": false }
                      }
                    },
                    {
                      "properties": {
                        "receipts_verified": { "const": false }
                      }
                    },
                    {
                      "properties": {
                        "target_invariants_verified": { "const": false }
                      }
                    },
                    {
                      "properties": {
                        "unknown_content_discarded": { "const": false }
                      }
                    }
                  ]
                },
                "exit_code": { "const": 1 }
              }
            }
          ]
        }
      ]
    }
  }
}
